# Exclude git repository
.git
.gitignore

# Exclude node_modules (this makes the transfer instant!)
**/node_modules
client/node_modules

# Exclude python cache and environments
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.venv
venv
env
.env
.env.*

# Exclude system and build caches
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea
.vscode
dist
build
out
